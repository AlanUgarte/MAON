// =============================================================
//  CRM COMERCIAL · WhatsApp Business + Meta Ads + IA (Claude)
//  Prisma Schema completo
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -----------------------------

enum Role {
  ADMINISTRADOR
  SUPERVISOR
  VENDEDOR
}

/// Estado comercial del lead/cliente (pipeline)
enum ClientStage {
  NUEVO_LEAD
  CONTACTADO
  INTERESADO
  NEGOCIANDO
  ESPERANDO_RESPUESTA
  VENTA_CERRADA
  VENTA_PERDIDA
}

/// Origen del lead
enum LeadSource {
  META_ADS
  WHATSAPP
  ORGANICO
  REFERIDO
  MANUAL
}

/// Intención de compra detectada por IA
enum BuyingIntent {
  ALTA
  MEDIA
  BAJA
  DESCONOCIDA
}

enum Sentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

/// Tipo de objeción detectada
enum ObjectionType {
  PRECIO
  ENVIO
  CONFIANZA
  TIEMPO_ENTREGA
  COMPETENCIA
  NINGUNA
}

enum MessageDirection {
  ENTRANTE
  SALIENTE
}

enum MessageType {
  TEXTO
  IMAGEN
  AUDIO
  VIDEO
  DOCUMENTO
  UBICACION
  PLANTILLA
  SISTEMA
}

/// Quién/qué generó el mensaje saliente
enum MessageAuthor {
  CLIENTE
  VENDEDOR
  AUTOMATIZACION
  IA
  SISTEMA
}

enum ConversationStatus {
  ABIERTA
  PENDIENTE
  CERRADA
}

/// Quién puede responder en esta conversación ahora mismo (MAON AI Sales).
/// Nunca deben responder la IA y una persona al mismo tiempo — whatsapp.service.ts
/// chequea esto antes de dejar correr el loop agéntico.
enum AIMode {
  AI_ACTIVE
  HUMAN_REQUESTED
  HUMAN_ACTIVE
  AI_PAUSED
}

enum CartStatus {
  ABIERTO
  CONFIRMADO
  ABANDONADO
}

enum PaymentStatus {
  PENDIENTE
  EN_PROCESO
  APROBADO
  RECHAZADO
  CANCELADO
  REEMBOLSADO
}

enum CampaignStatus {
  BORRADOR
  PROGRAMADA
  ENVIANDO
  COMPLETADA
  CANCELADA
}

enum CampaignRecipientStatus {
  PENDIENTE
  ENVIADO
  ENTREGADO
  LEIDO
  RESPONDIDO
  FALLIDO
}

enum AutomationTrigger {
  SIN_RESPUESTA_HORAS
  SIN_RESPUESTA_DIAS
  COMPRA_REALIZADA
  TIEMPO_DESDE_COMPRA
  CAMBIO_ESTADO
  NUEVO_LEAD
}

enum AutomationActionType {
  ENVIAR_MENSAJE
  ENVIAR_PLANTILLA
  CREAR_SEGUIMIENTO
  CAMBIAR_ESTADO
  AGREGAR_ETIQUETA
}

enum FollowUpStatus {
  PENDIENTE
  COMPLETADO
  VENCIDO
}

enum SaleStatus {
  PENDIENTE
  PAGADA
  ENVIADA
  ENTREGADA
  CANCELADA
}

/// Condición frente al IVA (AFIP/ARCA)
enum IvaCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  CONSUMIDOR_FINAL
  EXENTO
}

/// Letra del comprobante fiscal
enum ComprobanteLetra {
  A
  B
  C
  R
}

// ------------------------- USERS -----------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(VENDEDOR)
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedClients        Client[]       @relation("AssignedSeller")
  messages               Message[]      @relation("SellerMessages")
  notes                  Note[]
  followUps              FollowUp[]
  campaigns              Campaign[]
  sales                  Sale[]
  takenOverConversations Conversation[] @relation("TakenOverConversations")
  comprobantes           Comprobante[]  @relation("ComprobanteSeller")
  supremaSales           SupremaSale[]
  vynoOrdersApproved     VynoOrder[]    @relation("VynoOrderApprovedBy")
  insumosOrdersApproved  InsumosOrder[] @relation("InsumosOrderApprovedBy")

  @@index([role])
}

// ------------------------- TAGS ------------------------------

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#7C5CFC")
  createdAt DateTime @default(now())

  clients ClientTag[]
}

model ClientTag {
  clientId String
  tagId    String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

// ------------------------ CLIENTS ----------------------------

model Client {
  id        String  @id @default(cuid())
  // Información personal
  firstName String
  lastName  String?
  phone     String  @unique // E.164, ej: +5493411234567
  email     String?
  city      String?
  province  String?
  avatarUrl String?

  // Datos fiscales (para facturación)
  businessName   String? // Razón social, si difiere del nombre
  cuit           String?
  ivaCondition   IvaCondition @default(CONSUMIDOR_FINAL)
  address        String?
  postalCode     String?
  clientCode     String?      @unique // Código de cliente (ej: C029105)
  condicionVenta String       @default("Contado")

  // Información comercial
  stage               ClientStage @default(NUEVO_LEAD)
  source              LeadSource  @default(WHATSAPP)
  interestedProductId String?
  interestedProduct   Product?    @relation(fields: [interestedProductId], references: [id])

  // Atribución Meta Ads
  metaCampaignId String?
  metaAdSetId    String?
  metaAdId       String?
  metaCampaign   MetaCampaign? @relation(fields: [metaCampaignId], references: [id])

  // IA / scoring
  leadScore     Int           @default(0) // 0–100
  buyingIntent  BuyingIntent  @default(DESCONOCIDA)
  sentiment     Sentiment     @default(NEUTRO)
  aiSummary     String?
  lastObjection ObjectionType @default(NINGUNA)

  // Asignación
  assignedSellerId String?
  assignedSeller   User?   @relation("AssignedSeller", fields: [assignedSellerId], references: [id])

  lastContactAt DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tags               ClientTag[]
  conversations      Conversation[]
  notes              Note[]
  followUps          FollowUp[]
  sales              Sale[]
  aiAnalyses         AIAnalysis[]
  campaignRecipients CampaignRecipient[]
  comprobantes       Comprobante[]
  supremaSales       SupremaSale[]
  vynoOrders         VynoOrder[]
  insumosOrders      InsumosOrder[]

  @@index([stage])
  @@index([assignedSellerId])
  @@index([buyingIntent])
  @@index([lastInboundAt])
  @@index([metaCampaignId])
}

// --------------------- CONVERSATIONS -------------------------

model Conversation {
  id                 String             @id @default(cuid())
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status             ConversationStatus @default(ABIERTA)
  channel            String             @default("whatsapp")
  waContactId        String? // wa_id de WhatsApp Cloud API
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // --- MAON AI Sales: control IA/humano ---
  aiMode        AIMode    @default(AI_ACTIVE)
  aiPausedAt    DateTime?
  takenOverById String?
  takenOverBy   User?     @relation("TakenOverConversations", fields: [takenOverById], references: [id])

  messages Message[]
  cart     Cart?

  @@index([clientId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([aiMode])
}

// --------------------- MAON AI SALES --------------------------

/// Carrito ligado 1 a 1 a una conversación — lo arma la IA (o el vendedor) a
/// medida que el cliente confirma productos, y se confirma como Sale real
/// (mismo camino que ya usan /tienda y /cotillon vía POST /sales/storefront).
model Cart {
  id              String       @id @default(cuid())
  conversationId  String       @unique
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status          CartStatus   @default(ABIERTO)
  wantsShipping   Boolean?
  shippingAddress String?
  saleId          String?      @unique
  sale            Sale?        @relation(fields: [saleId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// Precio unitario al momento de agregarlo (no recalcula si cambia el catálogo después).
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([cartId])
}

/// Pago online de un pedido (Mercado Pago primero). Nunca se marca APROBADO
/// solo porque el cliente diga que pagó — solo lo hace el webhook real del proveedor.
model Payment {
  id          String        @id @default(cuid())
  saleId      String        @unique
  sale        Sale          @relation(fields: [saleId], references: [id])
  provider    String        @default("mercadopago")
  externalId  String?
  status      PaymentStatus @default(PENDIENTE)
  amount      Decimal       @db.Decimal(12, 2)
  checkoutUrl String?
  rawWebhook  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([externalId])
}

/// Auditoría de cada herramienta que usó la IA durante el loop agéntico
/// (sección 23 del spec de AI Sales) — separado de AIAnalysis, que audita el
/// análisis comercial (score/intención), no las llamadas a herramientas.
model AIToolCall {
  id             String   @id @default(cuid())
  conversationId String
  tool           String
  input          Json
  output         Json
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([tool])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  author         MessageAuthor    @default(CLIENTE)
  type           MessageType      @default(TEXTO)
  content        String
  mediaUrl       String?
  waMessageId    String?          @unique // id del mensaje en WhatsApp
  isRead         Boolean          @default(false)
  // Si lo envió un vendedor
  sellerId       String?
  seller         User?            @relation("SellerMessages", fields: [sellerId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ------------------------ AI LOG -----------------------------

/// Registro de cada análisis de IA (auditoría + ahorro de costos)
model AIAnalysis {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Resultado
  buyingIntent BuyingIntent?
  leadScore    Int?
  sentiment    Sentiment?
  objection    ObjectionType?
  nextAction   String?
  summary      String?
  suggestions  String[]       @default([])
  // Telemetría de costos
  usedAI       Boolean        @default(false) // false = resuelto por reglas/predefinido
  model        String?
  inputTokens  Int?
  outputTokens Int?
  rawResponse  Json?
  createdAt    DateTime       @default(now())

  @@index([clientId])
  @@index([usedAI])
}

// ------------------------ PRODUCTS ---------------------------

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  category     String?
  /// Sub-rubro dentro de la categoría (ej: "CEREALES" dentro de "Alimentos") — viene
  /// del Excel del proveedor (columna "Línea"), se usa en el desplegable de categorías.
  line         String?
  brand        String?
  /// Unidades por bulto (ej: 24 en "24*200 GR")
  unitsPerBulk Int?
  /// Margen de ganancia % de este artículo (si es null usa el general del negocio)
  marginPct    Float?
  price        Decimal  @db.Decimal(12, 2)
  cost         Decimal? @db.Decimal(12, 2)
  /// Precio de costo por unidad suelta (no null = el artículo también se vende por unidad,
  /// además de por bulto cerrado — ej. Landy Oritas, Chocolates, Vinos).
  unitPrice       Decimal? @db.Decimal(12, 2)
  /// Precio de costo por display (no null = también se vende por display, ej. Chocolates).
  displayPrice    Decimal? @db.Decimal(12, 2)
  /// Cantidad de unidades que trae un "zuncho" (paquete chico) cuando el artículo se
  /// vende así en vez de por unidad suelta — reutiliza unitPrice para el costo.
  unitsPerZuncho  Int?
  /// Unidades sueltas que trae un display (solo informativo).
  unitsPerDisplay Int?
  stock        Int      @default(0)
  description  String?
  images       String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interestedClients Client[]
  saleItems         SaleItem[]
  cartItems         CartItem[]

  @@index([category])
  @@index([isActive])
}

// -------------------------- SALES ----------------------------

model Sale {
  id                String        @id @default(cuid())
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  sellerId          String?
  seller            User?         @relation(fields: [sellerId], references: [id])
  total             Decimal       @db.Decimal(12, 2)
  status            SaleStatus    @default(PENDIENTE)
  // Atribución para reportes por campaña
  metaCampaignId    String?
  metaCampaign      MetaCampaign? @relation(fields: [metaCampaignId], references: [id])
  // Datos logísticos elegidos en el checkout de la tienda pública. Antes solo vivían
  // en el localStorage del navegador del admin — no había registro real compartido.
  wantsShipping     Boolean       @default(false)
  shippingAddress   String?
  availableSchedule String?
  envioGratis       Boolean       @default(false)
  // Estado de facturación: antes solo se guardaba en localStorage, cada navegador
  // podía mostrar un pedido como facturado o no de forma distinta al resto.
  invoiced          Boolean       @default(false)
  comprobanteNumero String?
  // Dark Store: barrio elegido en el checkout (valida contra DarkStoreSettings.deliveryBarrios)
  // y snapshot de líneas de vapeadores (no son Product, no entran en SaleItem).
  barrio            String?
  vapeItems         Json?         @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items   SaleItem[]
  cart    Cart?
  payment Payment?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  /// Aclara el modo de venta cuando no fue bulto cerrado (ej. "unidad", "zuncho x5") —
  /// sin esto el remito no puede distinguir "2 bultos" de "2 unidades sueltas" del mismo SKU.
  note      String?

  @@index([saleId])
}

// ------------------------ CAMPAIGNS --------------------------

model Campaign {
  id              String         @id @default(cuid())
  name            String
  message         String
  templateName    String?
  imageUrl        String?
  /// ACTIVE_WINDOW = gratis (solo conversaciones abiertas) · TEMPLATE = plantilla paga
  mode            String         @default("ACTIVE_WINDOW")
  status          CampaignStatus @default(BORRADOR)
  // Filtros aplicados (snapshot del segmento)
  filters         Json?
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  scheduledAt     DateTime?
  sentAt          DateTime?
  // Métricas agregadas
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  repliedCount    Int            @default(0)
  failedCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([status])
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  campaignId  String
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      CampaignRecipientStatus @default(PENDIENTE)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?
  error       String?

  @@unique([campaignId, clientId])
  @@index([status])
}

// ----------------------- AUTOMATIONS -------------------------

model Automation {
  id            String               @id @default(cuid())
  name          String
  isActive      Boolean              @default(true)
  trigger       AutomationTrigger
  // Parámetros del disparador, ej: { "hours": 48 } o { "days": 7 }
  triggerConfig Json?
  actionType    AutomationActionType
  // Contenido de la acción, ej: { "message": "..." } / { "stage": "INTERESADO" }
  actionConfig  Json?
  // Condiciones de segmento opcionales (mismo formato que filtros de campaña)
  conditions    Json?
  lastRunAt     DateTime?
  runCount      Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive])
}

// ----------------------- FOLLOW-UPS --------------------------

model FollowUp {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?          @relation(fields: [assignedToId], references: [id])
  title        String
  notes        String?
  dueAt        DateTime
  status       FollowUpStatus @default(PENDIENTE)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  @@index([status])
  @@index([dueAt])
  @@index([clientId])
}

// ------------------------ META ADS ---------------------------

model MetaCampaign {
  id        String   @id @default(cuid())
  metaId    String   @unique // id real de la campaña en Meta
  name      String
  objective String?
  status    String?
  spend     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
  sales   Sale[]
}

enum ComprobanteTipo {
  FACTURA
  REMITO
  NOTA_CREDITO
  NOTA_CREDITO_REMITO
}

/// Comprobante comercial: factura, remito o nota de crédito (incluye N/C en remito y N/C en blanco).
model Comprobante {
  id          String           @id @default(cuid())
  numero      String           @unique // ej: FC 0001-00000012
  tipo        ComprobanteTipo
  letra       ComprobanteLetra @default(A)
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id])
  sellerId    String?
  seller      User?            @relation("ComprobanteSeller", fields: [sellerId], references: [id])
  // Importes
  subtotal    Decimal          @db.Decimal(12, 2)
  iva         Decimal          @default(0) @db.Decimal(12, 2)
  total       Decimal          @db.Decimal(12, 2)
  sign        Int              @default(1) // +1 factura/remito (debe), -1 nota de crédito (haber)
  // Nota de crédito en blanco (sin productos, importe manual)
  enBlanco    Boolean          @default(false)
  descripcion String?
  // Fiscal (AFIP): se completa al obtener el CAE en producción
  cae         String?
  caeVto      DateTime?
  issuedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items ComprobanteItem[]

  @@index([clientId])
  @@index([tipo])
  @@index([issuedAt])
}

model ComprobanteItem {
  id            String      @id @default(cuid())
  comprobanteId String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  productId     String? // referencia opcional al producto
  detalle       String
  cantidad      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  /// Alícuota de IVA de este ítem (0.21, 0.105 o 0 = exento). Un comprobante puede mezclar alícuotas.
  ivaRate       Float       @default(0.21)

  @@index([comprobanteId])
}

// --------------------- CONFIG DE LA TIENDA --------------------

/// Fila única (singleton): configuración pública del storefront (banner, promos,
/// productos ocultos, etc.), antes vivía solo en localStorage del admin y por eso
/// no se veía igual desde otro dispositivo/navegador.
model TiendaSettings {
  id               String   @id @default("singleton")
  storeOpen        Boolean  @default(true)
  topBannerText    String   @default("Envíos a todo el país · Atención por WhatsApp")
  heroBadge        String   @default("Precios de mayorista, todo el año")
  heroTitle        String   @default("Golosinas, galletitas y alfajores al por mayor")
  heroSubtitle     String   @default("Armá tu pedido acá y confirmalo directo por WhatsApp — sin vueltas, sin registrarte.")
  /// URL de una imagen ya subida a otro lado (ej. Drive/Imgur con link directo) para
  /// reemplazar el fondo generado del banner por una imagen propia. Opcional.
  heroImageUrl     String?
  minCompra        Int      @default(50000)
  envioGratisDesde Int      @default(85000)
  whatsappNumber   String   @default("5493413807110")
  margenVenta      Float    @default(0.12)
  /// Ids de producto (del catálogo estático del front) ocultos en la tienda pública.
  hiddenProductIds String[] @default([])
  /// Mapa productId -> { label?, discountPct?, isNew? }
  productPromos    Json     @default("{}")
  /// Carrusel del banner principal: array de { id, imageUrl, title?, link?, active, order }.
  /// Reemplaza el banner de texto+fotos generado — si está vacío, la tienda muestra un fallback simple.
  heroCarousel     Json     @default("[]")
  /// Tarjetas promocionales chicas debajo del carrusel: misma forma que heroCarousel.
  promoCards       Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

/// Fila única (singleton): configuración de la landing de la estufa (/estufa), la
/// segunda tienda de prueba. Mismo patrón que TiendaSettings pero mucho más chica —
/// es un solo producto, no un catálogo.
model EstufaSettings {
  id             String   @id @default("singleton")
  storeOpen      Boolean  @default(true)
  topBannerText  String   @default("Envíos a todo el país · Stock disponible")
  heroBadge      String   @default("Calor instantáneo para tu casa")
  heroTitle      String   @default("Estufa Halógena de Cuarzo")
  heroSubtitle   String   @default("Calienta rápido cualquier ambiente chico o mediano, es liviana y se traslada fácil por toda la casa.")
  /// Precio de costo. El de venta se calcula con marginPct (mismo modelo costo+margen
  /// que el resto del catálogo mayorista) en vez de cargarse como un número aparte.
  cost           Decimal  @default(15000) @db.Decimal(12, 2)
  /// Fracción, no %: 0.3333 = 33.33% (igual convención que TiendaSettings.margenVenta).
  marginPct      Float    @default(0.3333)
  whatsappNumber String   @default("5493413807110")
  /// Carrusel de imágenes del hero — misma forma que TiendaSettings.heroCarousel. Si tiene
  /// algo activo, reemplaza la foto fija de /estufa/hero.png.
  heroCarousel   Json     @default("[]")
  updatedAt      DateTime @updatedAt
}

/// Fila única (singleton): configuración de /cotillon, la tercera tienda — catálogo real
/// (categoría "Cotillon" del catálogo mayorista, ~1300 artículos), no un producto único.
/// Mismo patrón que TiendaSettings porque es lo mismo que Tienda pero para otra línea
/// de productos y otra marca (FastCotillón, ex FastCombos, unificada acá).
model CotillonSettings {
  id               String   @id @default("singleton")
  storeOpen        Boolean  @default(true)
  topBannerText    String   @default("Cotillón para tu fiesta · Envíos a todo el país")
  heroBadge        String   @default("Cotillón para tu fiesta")
  heroTitle        String   @default("Todo el cotillón para tu evento")
  heroSubtitle     String   @default("Globos, decoración, disfraces y accesorios al por mayor. Armá tu pedido y confirmalo por WhatsApp.")
  heroImageUrl     String?
  minCompra        Int      @default(30000)
  envioGratisDesde Int      @default(60000)
  whatsappNumber   String   @default("5493413807110")
  margenVenta      Float    @default(0.3)
  hiddenProductIds String[] @default([])
  productPromos    Json     @default("{}")
  heroCarousel     Json     @default("[]")
  promoCards       Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

/// Fila única (singleton): configuración de /dark-store, la cuarta tienda — dark mode,
/// delivery express (Bebidas/Snacks/Chocolates del catálogo mayorista + Vapeadores propio),
/// horario acotado y validación de zona por barrio (sin geocoding real todavía).
model DarkStoreSettings {
  id                 String   @id @default("singleton")
  storeOpen          Boolean  @default(true)
  storeName          String   @default("MAON Dark Store")
  tagline            String   @default("Tu pedido en hasta 20 minutos.")
  logoUrl            String?
  heroCarousel       Json     @default("[]")
  promoCards         Json     @default("[]")
  /// Formato "HH:mm", zona horaria America/Argentina/Buenos_Aires.
  scheduleStart      String   @default("18:00")
  scheduleEnd        String   @default("23:00")
  deliveryEtaMinutes Int      @default(20)
  /// Costo de envío fijo (no varía por distancia ni por monto del pedido).
  deliveryFee        Int      @default(2000)
  /// Lista de barrios cubiertos — el checkout valida contra esto (sin geocoding real,
  /// ver notas del plan de implementación).
  deliveryBarrios    String[] @default(["Las Malvinas", "Refinería", "Luis Agote", "Alberto Olmedo", "Azcuénaga", "Barrio Parque", "Centro", "Bella Vista", "Latinoamérica", "Puerto Norte"])
  /// Porcentaje (25 = 25%), no fracción — misma convención que Product.marginPct.
  margenPct          Float    @default(25)
  lowStockThreshold  Int      @default(5)
  minOrderAmount     Int      @default(0)
  maxOrderAmount     Int?
  whatsappNumber     String   @default("5493413807110")
  whatsappTemplate   String?
  /// Alias bancario para transferencias — se adjunta al mensaje de WhatsApp del pedido.
  paymentAlias       String   @default("Alan.ugarte7")
  hiddenProductIds   String[] @default([])
  updatedAt          DateTime @updatedAt
}

/// Vapeadores de Dark Store: categoría administrada a mano, fuera del maestro del
/// proveedor (que pisaría estos datos en cada sync).
model DarkStoreVape {
  id          String   @id @default(cuid())
  name        String
  description String?
  brand       String?
  /// Precio de venta final — si cost/marginPct están cargados, el admin (frontend) lo
  /// recalcula solo y lo persiste acá; si no, es el precio cargado a mano como antes.
  price       Decimal  @db.Decimal(12, 2)
  /// Costo, opcional — a diferencia de Product no viene de ningún sync de proveedor, lo
  /// carga el admin a mano acá mismo para poder ver margen y ganancia como en Productos.
  cost        Decimal? @db.Decimal(12, 2)
  /// Margen % sobre cost — si no está, usa el margen general de Dark Store.
  marginPct   Float?
  stock       Int      @default(0)
  images      String[] @default([])
  /// Sabores/variantes (ej. "Cherry Watermelon") — si tiene más de uno, el detalle del
  /// producto muestra un desplegable para elegir. No cambia precio ni stock por sabor,
  /// es el mismo artículo físico en distintas presentaciones.
  flavors     String[] @default([])
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// --------------------- SUPREMAS DE POLLO ----------------------
// Negocio chico y separado dentro del mismo CRM: producción y venta de supremas
// rebozadas. Costo variable por lote (según precio de ingredientes) y precio por
// tramo de cliente — no encaja en Product/Sale (pensados para catálogo de miles
// de SKU con margen %), así que tiene su propio set de modelos. El cliente SÍ es
// el mismo Client de todo el CRM (nunca uno paralelo).

enum SupremaClientType {
  CONSUMIDOR_FINAL
  KIOSCO
  MAYORISTA
}

enum SupremaPaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
  OTRO
}

/// Fila única (singleton) — precios por tramo, umbral mayorista, costo de envase y
/// rendimiento base de producción. Mismo patrón que TiendaSettings/DarkStoreSettings.
model SupremaSettings {
  id                   String   @id @default("singleton")
  priceConsumidorFinal Decimal  @default(7000) @db.Decimal(12, 2)
  priceKiosco          Decimal  @default(6500) @db.Decimal(12, 2)
  priceMayorista       Decimal  @default(6000) @db.Decimal(12, 2)
  /// Kg desde los que se aplica precio kiosco (tramo medio) — configurable, no hardcodeado.
  kioscoMinKg          Int      @default(6)
  /// Kg desde los que se aplica precio mayorista — configurable, no hardcodeado.
  mayoristaMinKg       Int      @default(16)
  envaseCostPerKg      Decimal  @default(500) @db.Decimal(12, 2)
  /// Rendimiento: cuánta pechuga entra y cuánta suprema terminada sale de un lote base.
  pechugaBaseKg        Decimal  @default(5) @db.Decimal(12, 2)
  produccionBaseKg     Decimal  @default(9) @db.Decimal(12, 2)
  /// Si está en true, una venta que supere el stock actual se rechaza en vez de dejar stock negativo.
  blockNegativeStock   Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

/// Ingrediente del costeo (pechuga, huevos, pan rallado, condimentos, y los que se
/// agreguen después). El costo/kg vigente siempre se deriva en caliente de estas filas
/// + SupremaSettings — nunca se guarda un costo/kg fijo, así cambiar un ingrediente
/// actualiza al instante el costeo y lo que se usa en la próxima venta/lote.
model SupremaIngredient {
  id            String   @id @default(cuid())
  name          String
  purchaseQty   Decimal  @db.Decimal(12, 3)
  unit          String
  purchasePrice Decimal  @db.Decimal(12, 2)
  usedQty       Decimal  @db.Decimal(12, 3)
  supplier      String?
  updatedAt     DateTime @updatedAt
}

/// Producción por lote. costoTotal/costoPorKg quedan grabados (snapshot) con el costo
/// vigente al momento de crear el lote — no se recalculan retroactivamente si después
/// cambia el precio de un ingrediente (rompería la contabilidad histórica).
model SupremaBatch {
  id            String   @id @default(cuid())
  fecha         DateTime @default(now())
  lote          String
  kgProducidos  Decimal  @db.Decimal(12, 3)
  costoTotal    Decimal  @db.Decimal(12, 2)
  costoPorKg    Decimal  @db.Decimal(12, 2)
  observaciones String?
  createdById   String
  createdAt     DateTime @default(now())

  @@index([fecha])
}

/// Venta de supremas — cliente único del CRM (Client), no uno paralelo. pricePerKg se
/// autocompleta por clientType (editable solo por admin) y costPerKg queda grabado con
/// el costo vigente al momento de la venta (mismo criterio que SupremaBatch).
model SupremaSale {
  id            String                @id @default(cuid())
  clientId      String
  client        Client                @relation(fields: [clientId], references: [id])
  sellerId      String?
  seller        User?                 @relation(fields: [sellerId], references: [id])
  clientType    SupremaClientType
  kg            Decimal               @db.Decimal(12, 3)
  pricePerKg    Decimal               @db.Decimal(12, 2)
  costPerKg     Decimal               @db.Decimal(12, 2)
  total         Decimal               @db.Decimal(12, 2)
  cost          Decimal               @db.Decimal(12, 2)
  profit        Decimal               @db.Decimal(12, 2)
  marginPct     Decimal               @db.Decimal(6, 2)
  paymentMethod SupremaPaymentMethod
  observaciones String?
  fecha         DateTime              @default(now())
  createdById   String
  updatedById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([clientId])
  @@index([fecha])
  @@index([clientType])
}

// ------------------------------ VYNO --------------------------
// Tienda e-commerce real (retail directo, no mayorista): un producto por ahora
// (abridor de vino eléctrico), precio de venta directo + precio tachado, pago por
// transferencia con comprobante y aprobación manual del admin, envío con costo
// configurable a mano hasta conectar Andreani. Cliente único del CRM (Client), no uno
// paralelo — igual criterio que Supremas. Product/Sale no encajan acá: son mayoristas
// (precio de bulto + margen %), VYNO es retail con precio directo, stock por unidad y
// un estado de pedido mucho más granular (aprobación de pago + despacho + tracking).

enum VynoOrderStatus {
  NUEVO
  PAGO_PENDIENTE
  COMPROBANTE_RECIBIDO
  PAGO_VERIFICADO
  LISTO_PARA_DESPACHAR
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

model VynoProduct {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Precio de venta real. Arranca en 0 a propósito — significa "todavía sin
  /// configurar", no un precio válido. Lo carga el admin en /vyno-config.
  price          Decimal  @default(0) @db.Decimal(12, 2)
  /// Precio tachado (oferta) — opcional, no obligatorio para vender.
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  images         String[] @default([])
  description    String?
  installments   Int?
  ratingAvg      Decimal? @db.Decimal(2, 1)
  ratingCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems VynoOrderItem[]
}

model VynoOrder {
  id          String          @id @default(cuid())
  /// Numero de pedido legible para el cliente, ej. "VYNO-000001".
  orderNumber String          @unique
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  status      VynoOrderStatus @default(NUEVO)

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  // Envio
  province      String
  city          String
  postalCode    String
  street        String
  streetNumber  String
  floorApt      String?
  shippingNotes String?
  /// DNI/CUIT del comprador — opcional, algunos envios/facturas lo piden.
  docNumber     String?
  /// Nombre del servicio elegido (placeholder mientras no haya Andreani real).
  shippingMethod   String?
  /// Snapshot de la cotizacion usada (placeholder hoy, respuesta real de Andreani despues).
  shippingQuoteRaw Json?
  trackingNumber   String?
  carrier          String?

  // Aprobacion de pago — SIEMPRE la hace un admin, nunca el cliente ni el frontend.
  approvedById String?
  approvedBy   User?     @relation("VynoOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  items        VynoOrderItem[]
  paymentProof VynoPaymentProof?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model VynoOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     VynoOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   VynoProduct @relation(fields: [productId], references: [id])
  quantity  Int
  /// Precio unitario al momento de la compra (snapshot — no se recalcula si despues cambia el precio del producto).
  unitPrice Decimal     @db.Decimal(12, 2)
  subtotal  Decimal     @db.Decimal(12, 2)

  @@index([orderId])
}

/// Comprobante de transferencia que sube el cliente — nunca marca el pedido como
/// pagado por si solo, solo dispara el paso COMPROBANTE_RECIBIDO a la espera de que
/// un admin lo verifique a mano.
model VynoPaymentProof {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           VynoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  imageUrl        String
  operationNumber String?
  transferredAt   DateTime?
  holderName      String?
  comment         String?
  createdAt       DateTime  @default(now())
}

/// Fila unica (singleton) — costo de envio placeholder mientras no haya Andreani
/// conectado, alias de transferencia y textos institucionales del footer.
model VynoSettings {
  id                 String   @id @default("singleton")
  shippingFlatCost   Decimal  @default(0) @db.Decimal(12, 2)
  paymentAlias       String   @default("Alan.ugarte7")
  aboutText          String?
  privacyPolicy      String?
  termsAndConditions String?
  returnsPolicy      String?
  updatedAt          DateTime @updatedAt
}

// ── UGARTE INSUMOS CARNICERIA — tienda de insumos para carnicerias (arranca con
// hojas de sierra Kaiser). Mismo patron que VYNO: modelos propios, Client compartido.

enum InsumosOrderStatus {
  NUEVO
  PAGO_PENDIENTE
  COMPROBANTE_RECIBIDO
  PAGO_VERIFICADO
  LISTO_PARA_DESPACHAR
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

model InsumosProduct {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Precio de venta real. Arranca en 0 a proposito — significa "todavia sin
  /// configurar", no un precio valido. Lo carga el admin en /insumos-config.
  price          Decimal  @default(0) @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  images         String[] @default([])
  description    String?
  ratingAvg      Decimal? @db.Decimal(2, 1)
  ratingCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems InsumosOrderItem[]
}

model InsumosOrder {
  id          String             @id @default(cuid())
  orderNumber String             @unique
  clientId    String
  client      Client             @relation(fields: [clientId], references: [id])
  status      InsumosOrderStatus @default(NUEVO)

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  province      String
  city          String
  postalCode    String
  street        String
  streetNumber  String
  floorApt      String?
  shippingNotes String?
  docNumber     String?
  shippingMethod   String?
  shippingQuoteRaw Json?
  trackingNumber   String?
  carrier          String?

  approvedById String?
  approvedBy   User?     @relation("InsumosOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        InsumosOrderItem[]
  paymentProof InsumosPaymentProof?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InsumosOrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     InsumosOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   InsumosProduct @relation(fields: [productId], references: [id])
  quantity  Int
  /// Medida elegida (largo en metros, ej. "3.50") — el producto tiene precio unico
  /// pero se vende por medida, el cliente tiene que elegir una antes de comprar.
  size      String?
  unitPrice Decimal        @db.Decimal(12, 2)
  subtotal  Decimal        @db.Decimal(12, 2)

  @@index([orderId])
}

/// Comprobante de transferencia que sube el cliente — nunca marca el pedido como
/// pagado por si solo, solo dispara COMPROBANTE_RECIBIDO a la espera de que un
/// admin lo verifique a mano.
model InsumosPaymentProof {
  id         String       @id @default(cuid())
  orderId    String       @unique
  order      InsumosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Opcional a pedido de Alan: con el nombre del titular alcanza para informar el
  /// pago, el comprobante es un extra si el cliente lo tiene a mano.
  imageUrl   String?
  holderName String
  createdAt  DateTime     @default(now())
}

/// Fila unica (singleton) — costo de envio, alias de transferencia y textos
/// institucionales del footer.
model InsumosSettings {
  id                 String   @id @default("singleton")
  shippingFlatCost   Decimal  @default(0) @db.Decimal(12, 2)
  paymentAlias       String   @default("Alan.ugarte7")
  aboutText          String?
  privacyPolicy      String?
  termsAndConditions String?
  returnsPolicy      String?
  updatedAt          DateTime @updatedAt
}
